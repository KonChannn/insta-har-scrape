{
  "name": "ig-har-analyzer",
  "version": "2.0.0",
  "private": true,
  "description": "Local-first Instagram HAR analyzer — runs entirely in the browser.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts && tsx scripts/render-smoke.tsx",
    "smoke:engine": "tsx scripts/smoke.ts",
    "smoke:render": "tsx scripts/render-smoke.tsx",
    "fixture:har": "tsx scripts/emit-har.ts public/demo.har"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
